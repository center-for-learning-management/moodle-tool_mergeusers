# Configuration for the "Sync from upstream" reusable workflow.
# Lives in the TARGET repository at: .github/upstream/config.env
#
# Plain KEY=VALUE lines, no quotes needed. This file is appended straight
# into $GITHUB_ENV by the reusable workflow, so keep it simple.
 
UPSTREAM_REPO=jpahullo/moodle-tool_mergeusers
UPSTREAM_BRANCH=MOODLE_405_STABLE
PR_BASE_BRANCH=master
PR_BRANCH=PR_UPSTREAM_MOODLE_405_STABLE
PR_ASSIGNEES=lassnj
PR_REVIEWERS=lassnj
# Path(s) to reset back to PR_BASE_BRANCH before opening the PR (e.g. keep
# your own workflow files instead of the upstream ones). Space-separated if
# you need more than one path.
IGNORE_PATH=.github/workflows
 